{
  "name": "clinic-erp",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/crm",
    "apps/api",
    "apps/mobile",
    "packages/*"
  ],
  "overrides": {
    "react-native": "0.76.9",
    "@react-native/codegen": "0.76.9",
    "@react-native/babel-plugin-codegen": "0.76.9",
    "@react-native/babel-preset": "0.76.9"
  },
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:crm": "npm run dev --workspace=apps/crm",
    "build": "npm run build --workspace=apps/crm",
    "test:api": "npm test --workspace=apps/api",
    "test:api:file": "npm test --workspace=apps/api --",
    "test:crm": "npm test --workspace=apps/crm",
    "test:crm:file": "npm test --workspace=apps/crm --",
    "typecheck:mobile": "npm run typecheck --workspace=apps/mobile",
    "test:mobile": "npm test --workspace=apps/mobile",
    "android:apk": "bash apps/mobile/scripts/build-android-apk.sh",
    "maestro:android": "bash apps/mobile/scripts/run-maestro-android.sh",
    "maestro:android:full": "bash apps/mobile/scripts/run-android-maestro.sh",
    "maestro:login": "MAESTRO_FLOWS=login-smoke.yaml bash apps/mobile/scripts/run-maestro-android.sh",
    "test:e2e:spec": "npm run test:e2e --workspace=apps/crm --",
    "test:e2e": "npm run test:e2e --workspace=apps/crm",
    "test:e2e:smoke": "npm run test:e2e:smoke --workspace=apps/crm",
    "test:e2e:full": "npm run test:e2e:full --workspace=apps/crm",
    "seed:e2e": "npm run seed:e2e --workspace=apps/api",
    "seed:e2e:local": "npm run seed:e2e:local --workspace=apps/api",
    "verify:local": "bash scripts/verify-local.sh verify",
    "verify:local:smoke": "bash scripts/verify-local.sh smoke",
    "verify:local:full": "bash scripts/verify-local.sh full"
  }
}
