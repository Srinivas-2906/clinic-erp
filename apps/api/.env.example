# Clinic ERP — environment configuration reference
#
# Copy to apps/api/.env for local development. Never commit secrets.
# Validate: node scripts/validate-pilot-env.mjs [--pilot|--commercial]

PORT=3010
NODE_ENV=development

# ── Authentication (required pilot+) ──
JWT_SECRET=clinic-dev-secret-change-in-production
JWT_EXPIRES=7d

# ── SQLite (required all tiers) ──
DATABASE_PATH=./data/clinic.db
DATA_DIR=./data

# ── CRM URLs (required pilot+ for password reset / invites) ──
CLINIC_CRM_URL=http://localhost:5185
PUBLIC_URL=http://localhost:3010

# ── Litestream (required controlled pilot / staging on Cloud Run) ──
# LITESTREAM_BUCKET=your-staging-clinic-db-bucket
# Replicate URL configured in Dockerfile / entrypoint — see apps/api/docker-entrypoint.sh

# ── Clinical file storage ──
# local | memory (tests) | gcs (pilot/staging/prod)
CLINIC_FILES_STORAGE=local
UPLOADS_DIR=./data/uploads
# Pilot/staging GCS:
# CLINIC_FILES_STORAGE=gcs
# CLINIC_FILES_BUCKET=your-clinic-files-bucket
# CLINIC_FILES_PREFIX=clinic-files-staging

# ── Transactional email (required pilot+ for real password reset) ──
# CLINIC_EMAIL_PROVIDER=console|smtp|resend
# CLINIC_EMAIL_FROM="Clinic Desk <noreply@yourdomain.com>"
# SMTP: CLINIC_SMTP_HOST, CLINIC_SMTP_PORT=587, CLINIC_SMTP_USER, CLINIC_SMTP_PASS, CLINIC_SMTP_SECURE=0
# Resend: CLINIC_RESEND_API_KEY=re_...
PASSWORD_RESET_EXPIRY_MINUTES=60
FORGOT_PASSWORD_RATE_MAX=5
FORGOT_PASSWORD_RATE_WINDOW_MS=900000

# ── Signup / provisioning ──
# CLINIC_PUBLIC_SIGNUP_ENABLED=1
# CLINIC_PROVISIONING_API_KEY=...
# CLINIC_TRIAL_DAYS=14

# ── Reminders (do not enable live delivery without approval) ──
# REMINDER_DELIVERY_ENABLED=0
# REMINDER_EXTERNAL_SCHEDULER=1
# DISABLE_REMINDER_WORKER=1

# ── Subscription billing (commercial sandbox — no live charges in CI) ──
# CLINIC_PAYMENT_GATEWAY=razorpay_sandbox
# CLINIC_RAZORPAY_WEBHOOK_SECRET=whsec_dev_only_change_in_production
# Test-mode Razorpay (Subscriptions API — map dashboard plan ids):
# CLINIC_PAYMENT_GATEWAY=razorpay
# CLINIC_RAZORPAY_KEY_ID=rzp_test_...
# CLINIC_RAZORPAY_KEY_SECRET=...
# CLINIC_RAZORPAY_PLAN_ESSENTIAL=plan_...
# CLINIC_RAZORPAY_PLAN_PROFESSIONAL=plan_...
# CLINIC_RAZORPAY_PLAN_ENTERPRISE=plan_...
# CLINIC_RAZORPAY_MOCK=1
# CLINIC_SUBSCRIPTION_GRACE_DAYS=7
# Live (requires explicit approval — not enabled in repo CI):
# CLINIC_PAYMENT_LIVE_ENABLED=1

# ── Dev-only (never production) ──
SKIP_DEMO_SEED=0
# CLINIC_PASSWORD_RESET_EXPOSE_TOKEN=1
# CLINIC_ALLOW_RESET_TOKEN_EXPOSE=1
