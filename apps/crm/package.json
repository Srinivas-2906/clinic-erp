{
  "name": "clinic-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test --project=chromium-desktop",
    "test:e2e:smoke": "E2E_GREP=@smoke playwright test --project=chromium-desktop",
    "test:e2e:full": "playwright test --project=chromium-desktop && playwright test --project=chromium-mobile",
    "test:e2e:regression": "npm run test:e2e:full",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:visual": "playwright test --project=chrome-visual",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:desktop": "playwright test --project=chromium-desktop",
    "test:e2e:staging": "playwright test --config playwright.staging.config.ts",
    "test:e2e:report": "playwright show-report e2e/report",
    "test:e2e:install": "playwright install chromium",
    "seed:e2e": "npm run seed:e2e --prefix ../clinic-api",
    "test:phase1": "npm run build && npm test --prefix ../clinic-api"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0"
  }
}
