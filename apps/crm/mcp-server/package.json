{
  "name": "clinic-desk-mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server: Clinic Desk Playwright screenshots and E2E test runner",
  "bin": {
    "clinic-mcp": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "auth:save": "node scripts/save-auth.mjs",
    "capture": "node scripts/capture-cli.mjs",
