# Clinic CRM — Vite environment
# Copy to apps/crm/.env.local for local development.

# Default tenant slug (local demo: dentacare)
VITE_TENANT_SLUG=dentacare

# API base — unset uses Vite dev proxy (/api → localhost:3010)
# VITE_CLINIC_API=http://127.0.0.1:3010/api

# E2E (Playwright global setup)
# E2E_API_URL=http://127.0.0.1:3010
# E2E_TENANT=dentacare
